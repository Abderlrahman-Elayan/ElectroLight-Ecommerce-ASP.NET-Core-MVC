    @if (ViewData["PageType"] as string == "admin-page")
    {
        <nav style="display:flex;justify-content:space-between">
        <a class="home-link ps-4" asp-controller="home" asp-action="index">
          
            <img src="~/img/logo.png" class="logo" alt="RlectroLight logo" />
        </a>
        <li class="dropdown nav-item" style="display:block">
            <button class="dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                Content Mangement
            </button>
            <ul class="dropdown-menu">
                <li><a class="dropdown-item" asp-controller="category" asp-action="index">Categories</a></li>
                <li><a class="dropdown-item" asp-controller="product" asp-action="index">Products</a></li>
            </ul>
        </li>
        <button id="themeToggle"
                class="btn btn-outline-secondary"
                style="position:fixed; top:45px; right:0; z-index:999;">
            <i class="bi bi-moon-fill"></i>
        </button>
        </nav>
    }
    
    <div>
        <main role="main">
            <partial name="_Notification" />

            @RenderBody()
        </main>
    </div>

    @* <footer class="border-top footer text-muted">
        <div class="container">
            Oh Shit!
        </div>
    </footer> *@
    @* <script src="~/lib/jquery/dist/jquery.min.js"></script> *@
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="//cdn.datatables.net/2.3.7/js/dataTables.min.js"></script>
