@model IEnumerable<Category>

<div class="card">
    <div class="card-header bg-primary bg-gradient text-center p-2">
        <h2 class="text-dark fw-bold">Categories</h2>
    </div>
    <div class="card-body">
        <div class="row p-3">
            <a asp-controller="Category" asp-action="Upsert" 
            class="btn btn-warning mb-3 ms-auto col-3 p-2 text-dark fw-bold">
               <i class="bi bi-plus-circle"></i> Add New Category
            </a>
        <table class="table border table-striped table-bordered">
            <thead>
                <tr class="bg-black">
                    <th class="text-center" text-light>Name</th>
                    <th class="text-center" text-light>Description</th>
                    <th class="text-center" text-light></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var category in Model)
                {
                    <tr >
                        <td class="col-3">@category.Name</td>
                        <td>@category.Description</td>
                        <td class="text-center col-3">
                                <a asp-controller="Category" asp-action="Upsert" asp-route-categoryId="@category.Id"
                                   class="btn btn-success mx-2 text-dark fw-bold">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                                <a asp-controller="Category" asp-action="Delete" asp-route-categoryId="@category.Id"
                                   class="btn btn-danger mx-2 text-dark fw-bold">
                                    <i class="bi bi-trash"></i> Delete
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    </div>
</div>
