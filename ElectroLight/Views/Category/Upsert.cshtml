@model Category

<div class="card shadow-lg">
    @if (Model.Id == 0)
    {
        <div class="card-header bg-warning bg-gradient text-center text-light"><h2 class="text-dark fw-bold">Create Category</h2></div>
    }
    else
    {
        <div class="card-header bg-success bg-gradient text-center"><h2 class="text-dark fw-bold">Edit Category</h2></div>
    }
    <div class="card-body">
        <div class="row">
            <form asp-action="Upsert">
                <div class="row">
                    <div asp-validation-summary="All" class="text-danger"></div>
                    <div class="form-floating p-2 mb-2 col-6 py-3">
                        <label asp-for="Name" class="control-label ms-2"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="form-floating p-2 mb-3 col-6  py-3">
                        <label asp-for="Description" class="control-label ms-2"></label>
                        <input asp-for="Description" class="form-control" />
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                </div>
                <div class="form-group">
                    @if (Model.Id == 0)
                    {
                        <input type="submit" value="Create" class="btn btn-warning text-dark fw-bold" />
                    }
                    else
                    {
                        <input type="submit" value="Edit" class="btn btn-success text-dark fw-bold" />

                    }
                </div>
            </form>
        </div>
    </div>
</div>


<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
