@model Category
<div class="card">
    <div class="card-header bg-success bg-gradient text-center"><h2 class="text-light">Edit Category</h2></div>
    <div class="card-body">
        <div class="row">
            <form asp-action="Update">
                <input hidden asp-for="Id" />
                <div class="row">
                    <div asp-validation-summary="All" class="text-danger"></div>
                    <div class="form-floating p-2 mb-2 col-6 py-3">
                        <label asp-for="Name" class="control-label ms-2"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="form-floating p-2 mb-3 col-6  py-3">
                        <label asp-for="Description" class="control-label ms-2"></label>
                        <input asp-for="Description" class="form-control" />
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                </div>
                <div class="form-group">
                    <input type="submit" value="Edit" class="btn btn-success" />
                </div>
            </form>
        </div>
    </div>
</div>


<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
