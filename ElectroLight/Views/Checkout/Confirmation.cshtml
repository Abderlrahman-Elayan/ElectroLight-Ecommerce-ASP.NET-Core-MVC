@model Order

<div class="confirmation-container">

    <div class="confirmation-card">

        <div class="success-icon">✔</div>

        <h2>Order Placed Successfully!</h2>

        <p class="order-id">Order ID: #@Model.Id</p>

        <p class="order-status">Status: @Model.Status</p>

        <div class="order-details">

            <h3>Order Details</h3>

            @foreach (var item in Model.OrderItems)
            {
                <div class="order-item">
                    <span>@item.Product.Name</span>
                    <span>@item.Quantity x @item.Price.ToString("c")</span>
                </div>
            }

            <div class="order-total">
                <span>Total</span>
                <span>@Model.TotalPrice.ToString("c")</span>
            </div>

        </div>

        <div class="actions">
            <a asp-controller="Home" asp-action="Index" class="btn btn-home">
                Continue Shopping
            </a>

            <a asp-controller="Checkout" asp-action="MyOrders" class="btn btn-orders">
                View My Orders
            </a>
        </div>

    </div>

</div>