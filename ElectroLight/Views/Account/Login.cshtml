@model LoginVM
<div id="targetElement">

<section class="account-section">
    <div class="content-account-container">
            <a class="back-btn btn" href="@(Model.ReturnUrl ?? "/")"><i class="bi bi-arrow-left-circle-fill"></i></a>
        <div class="grid grid-col-2 grid-gap-lg">
            <div class="account-form-box">
                <h1 class="account-form-title">Sign In</h1>
                <form method="post" asp-action="Login">
                <div asp-validation-summary="All" class="text-danger"></div>
                    <input asp-for="ReturnUrl" hidden />
                    <span asp-validation-for-all="all" class="text-danger"></span>
                    <div class="form-group account-group">
                        <label asp-for="Email" class="account-label"></label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="form-group account-group">
                        <label asp-for="Password" class="account-label"></label>
                        <input asp-for="Password" class="form-control" type="password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    <div class="account-group remember-me-group">
                        <input asp-for="RememberMe" class="" type="checkbox" />
                        <label asp-for="RememberMe"></label>
                        <span asp-validation-for="RememberMe" class="text-danger"></span>
                    </div>
                    <input type="submit" value="Login" class="account-submit-button" />
                </form>
                    <a asp-controller="Account" asp-action="Register" class="dont-have-account" asp-route-returnUrl="@Model.ReturnUrl">Don't have an account?</a>
            </div>
            <div class="account-img-box">
                <img src="~/img/boy-in-blue.png" alt="Man working on laptop with headphones" />
            </div>
        </div>
    </div>
</section>

</div>




@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        window.addEventListener("load", function () {
            const el = document.getElementById("targetElement");

            el.scrollIntoView({
                behavior: "smooth",
                block: "center"
            });
        });
    </script>
}

