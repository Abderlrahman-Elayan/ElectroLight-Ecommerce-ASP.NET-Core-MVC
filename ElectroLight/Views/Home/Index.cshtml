@using ElectroLight.Application.Utilies
@using Microsoft.AspNetCore.Identity;

@inject UserManager<ApplicationUser> userManager;
@inject SignInManager<ApplicationUser> signInManager;
@{
    var user = await userManager.GetUserAsync(User);
}

@model HomeVM
<header class="header">
    <a class="home-link" asp-controller="home" asp-action="index">
        <img src="~/img/logo.png" class="logo" alt="RlectroLight logo" />
    </a>
    <nav>
        <ul class="nav-list">
            @if (User.IsInRole(SD.Role_Admin))
            {
                <li class="dropdown nav-item">
                    <button class="dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        Content Mangement
                    </button>

                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" asp-controller="category" asp-action="index">Categories</a></li>
                        <li><a class="dropdown-item" asp-controller="product" asp-action="index">Products</a></li>
                        <li><a class="dropdown-item" asp-controller="Order" asp-action="index">Orders</a></li>
                    </ul>
                </li>
            }
            <li class="nav-item cart-icon">
                <a class="button" asp-controller="shoppingcart" asp-action="index">
                    <i class="bi bi-cart4"></i>
                    <span id="cart-count" class="cart-badge">0</span>
                </a>
            </li>
            
            <li class="nav-item">
                <a asp-controller="Checkout" asp-action="MyOrders">
                    View My Orders
                </a>
            </li>
            <li class="nav-item">
                <a href="#categroies" class="button">Categroies</a>
            </li>
            <li class="nav-item">
                <a class="button" href="#newest-section">New</a>
            </li>
            <li class="nav-item">
                <a class="button" href="#featured-section">Recommended</a>
            </li>
            @if (!signInManager.IsSignedIn(User))
            {
                <li class="nav-item">
                    <a class="button regester-button" asp-controller="Account" asp-action="Register">Register</a>
                </li>
   
            }
            else
            {
                <li class="nav-item button-hero-login">
                    <a class="button " asp-controller="Account" asp-action="Logout">Logout</a>
                </li>
            }
        </ul>

    </nav>
    @if (signInManager.IsSignedIn(User))
    {
        <span class="hello-user">
            Welecome, <span>@user?.FullName</span>
        </span>
        
    }
</header>

@* Hero Section *@
<section class="hero-section">
    <div class="container">
        <div class="hero">
            <div class="hero-text-box">
                <p class="shop-text">
                    Light up your life with smart technology
                </p>
                <h1 class="heading-primary"> Upgrade your home with smart, modern technology</h1>
                <p class="hero-description">
                    Discover high-quality, stylish, and innovative devices designed to make your everyday life easier, smarter, and more efficient.
                </p>
                <a class="button button-primary me-4" href="#featured-section">Upgrade Your Home</a>
                @if (!signInManager.IsSignedIn(User))
                {
                    <a class="button button-hero-login" asp-controller="Account" asp-action="Login">Login</a>
                }
                   
            </div>
            <div class="hero-img-box">
                <img src="~/img/hero.png" class="hero-img" />
            </div>
        </div>
    </div>
</section>
@* About Section *@
<section class="about-section text-center">
    <h2 class="about-title">ElectroLight: Illuminate Your World with Style </h2>
    <p class="about-text">Explore a wide range of lighting and electrical products crafted to bring comfort, brightness, and modern design into your life. At ElectroLight, we combine quality, innovation, and affordability to power your everyday needs. </p>
</section>

@* Categroies Section *@
<section class="categories-section heading-primary" id="categroies">
    <div class="container ">
        <span class="tag">Categories</span>
        <div class="grid-col-4 grid">
            @foreach (var category in Model.categoriesList)
            {
                <a class="show-card button" asp-controller="product" asp-action="ProductsShow" asp-route-categoryId="@category.Id">
                    <img class="show-image " src="@category.ImageUrl" alt="@category.Description" onerror="this.onerror=null;this.src='/img/placeholder.jpg';" />
                    <span class="category-label">@category.Name</span>
                </a>
            }
        </div>
    </div>

</section>


@* Newest Section *@
<section class="newest-products-section" id="newest-section">
    <div class="container justify-content-center">
        <span class="tag">Newest</span>
        <div id="newest-products-container" class="grid-col-5 grid">
            @foreach (var product in Model.newestProductsList)
            {
                <div class="show-card button">
                    <a style="text-decoration:none" asp-controller="product" asp-action="ProductDetails" asp-route-productId="@product.Id">
                        <img class="show-image" src="@product.ImageUrl" loading="lazy" alt="@product.Description" onerror="this.onerror=null;this.src='/img/placeholder.jpg';" />
                        <div class="show-card-body align-content-center ">
                            <p class="show-card-description">@product.Description</p>
                            <p class="product-name text-center">@product.Name</p>
                        </div>
              
                    </a>
                    <div class="flex-price">
                        @if (signInManager.IsSignedIn(User))
                        {
                            <button class="add-to-cart-btn  btn-link p-0"
                                    data-product-id="@product.Id">
                                <i class="bi bi-cart-plus fs-4"></i>
                            </button>
                        }
                        <p class="product-price">@product.Price.ToString("c")</p>

                    </div>
                </div>
            }
        </div>
        <div class="text-center mt-4">
            <button id="load-more-newest"
                    class="button load-more">
                Load More
            </button>
        </div>
    </div>

</section>

@* Featured Section *@
<section class="featuerd-products-section" id="featured-section">
    <div class="container justify-content-center">
        <span class="tag">Recommend<i class="bi bi-fire text-danger"></i></span>
        <div id="featured-products-container" class="grid-col-5 grid">
            @foreach (var product in Model.featuredProductsList)
            {
                <div class="show-card button">
                    <a style="text-decoration:none" asp-controller="product" asp-action="ProductDetails" asp-route-productId="@product.Id">
                        <img class="show-image" src="@product.ImageUrl" loading="lazy" alt="@product.Description" onerror="this.onerror=null;this.src='/img/placeholder.jpg';" />
                        <div class="show-card-body align-content-center ">
                            <p class="show-card-description">@product.Description</p>
                            <p class="product-name text-center">@product.Name</p>
                        </div>
                    </a>
                    <div class="flex-price">
                        @if (signInManager.IsSignedIn(User))
                        {
                        <button class="add-to-cart-btn  btn-link p-0"
                                data-product-id="@product.Id">
                            <i class="bi bi-cart-plus fs-4"></i>
                        </button>
                        }
                        <p class="product-price">@product.Price.ToString("c")</p>
                    </div>
                </div>
            }
        </div>
        <div class="text-center mt-4">
            <button id="load-more-featured"
                    class="button load-more">
                Load More
            </button>
        </div>
    </div>
</section>


@section Scripts {
    <script>
        $(function () {

            // ✅ Load real cart count on page load
            $.get('/ShoppingCart/GetCartCount', function (res) {
                updateCartBadge(res.count);
            });

            // ✅ Add to cart click
            $(".add-to-cart-btn").on("click", function () {

                var button = $(this);
                var icon = button.find("i");
                var productId = button.data("product-id");

                // ✅ prevent spam clicking
                button.prop("disabled", true);

                $.ajax({
                    url: '/ShoppingCart/AddOrUpdateItem',
                    type: 'POST',
                    data: {
                        productId: productId,
                        quantity: 1
                    },

                    success: function (res) {

                        // ✅ icon animation
                        icon.removeClass("bi-cart-plus")
                            .addClass("bi-check text-success");

                        setTimeout(function () {
                            icon.removeClass("bi-check text-success")
                                .addClass("bi-cart-plus");
                        }, 1500);

                        // ✅ update real cart count
                        updateCartBadge(res.count);

                        // ✅ toastr success
                        toastr.success("Added to cart successfully");
                    },

                    error: function (xhr) {

                        let message = "Error adding to cart";

                        // ✅ read backend error message
                        if (xhr.responseJSON &&
                            xhr.responseJSON.message) {

                            message = xhr.responseJSON.message;
                        }

                        // ✅ toastr error
                        toastr.error(message);
                    },

                    complete: function () {

                        // ✅ enable button again
                        button.prop("disabled", false);
                    }
                });

            });

        });

        // ✅ cart badge handler
        function updateCartBadge(count) {

            if (count <= 0) {

                $("#cart-count").hide();

            } else {

                $("#cart-count")
                    .show()
                    .text(count);
            }
        }
    </script>
    <script>

        let featuredSkip = 11;
        let newestSkip = 11;

        const take = 5;

        // ==========================
        // Featured Load More
        // ==========================

        $("#load-more-featured").on("click", async function () {

            const button = $(this);

            const response = await fetch(
                `/Home/LoadMoreFeaturedProducts?skip=${featuredSkip}&take=${take}`
            );

            const html = await response.text();

            // no more products
            if (html.trim() === "") {

                button.hide();
                return;
            }

            $("#featured-products-container")
                .append(html);

            featuredSkip += take;
        });

        // ==========================
        // Newest Load More
        // ==========================

        $("#load-more-newest").on("click", async function () {

            const button = $(this);

            const response = await fetch(
                `/Home/LoadMoreNewestProducts?skip=${newestSkip}&take=${take}`
            );

            const html = await response.text();

            // no more products
            if (html.trim() === "") {

                button.hide();
                return;
            }

            $("#newest-products-container")
                .append(html);

            newestSkip += take;
        });

    </script>
}