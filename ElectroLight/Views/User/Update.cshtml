@{
    ViewData["PageType"] = "admin-page";
}
@model UserVM
<div class="container custom-view mt-3">
    <div class="card shadow-lg">
            <div class="card-header bg-success bg-gradient text-center"><h1 class="text-dark fw-bold title-card-header">Edit User</h1></div>
        <div class="card-body">
            <div class="row">
                <form asp-action="Update" >
                    <input hidden asp-for="Id" />
                    <div class="row">
                        <div asp-validation-summary="All" class="text-danger"></div>
                        <div class="form-floating   col-6 py-1 mb-3">
                            <input asp-for="FullName" required class="form-control" />
                            <label asp-for="FullName" class="control-label ms-2"></label>
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>
                        <div class="form-floating   col-6  py-1 mb-3">
                            <input asp-for="Email" required class="form-control" />
                            <label asp-for="Email" class="control-label ms-2"></label>
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                        <div class="form-floating   col-6  py-1 mb-3">
                            <input asp-for="PhoneNumber" required class="form-control" type="number" step="0.01" />
                            <label asp-for="PhoneNumber" class="control-label ms-2"></label>
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>
                        <div class="form-floating  col-6  pb-1 mb-3">
                            <select asp-for="Role" asp-items="@Model.Roles" class="form-select border shadow">
                                <option value="" disabled selected>-- Select Role --</option>
                            </select>
                            <label asp-for="Role" class="control-label ms-2"></label>
                            <span asp-validation-for="Role" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="form-group align-items-center">
                            <input type="submit" value="Edit" class="btn btn-success text-dark fw-bold " />
                    </div>

                </form>
            </div>
        </div>
    </div>
    <div>
        <a asp-action="Index">Back to List</a>
    </div>
</div>
