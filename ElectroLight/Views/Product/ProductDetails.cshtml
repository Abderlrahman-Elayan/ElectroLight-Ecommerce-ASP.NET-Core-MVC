@model ProductShowVM

<header class="categroies-header ">
    <div class="text-url-history-span text-url-history">
        <a class="text-url-history" asp-controller="Home" asp-action="Index">Home</a>
        @if (Model.CategoryName != null)
        {
            <i class="bi bi-chevron-right"></i>
            @Model.CategoryName
        }
    </div>

    <div class="container-fluid categories-nav">
        <div class="scroll-x category-tag-container ">
            @foreach (var category in Model.CategoriesList)
            {
                <a class="category-tag button"
                       asp-action="ProductsShow"
                       asp-route-categoryId="@category.Id">
                    @category.Name
                </a>
            }
        </div>
    </div>
</header>

<section class="details-product-section add-to-cart-container">
    <div class="container-fluid grid grid-col-auto-1 ">

        <div class="details-product-image-wrapper">
            <img class="show-image details-image"
                 src="@Model.Product.ImageUrl"
                 alt="@Model.Product.Description"
                 onerror="this.onerror=null;this.src='/img/placeholder.jpg';" />
        </div>

        <div class="product-details-box">
            <p class="details-description">@Model.Product.Description</p>
            <p class="details-name">@Model.Product.Name</p>

            <div class="flex product-detials-price-quantity">
                <div class="quantity-detials">
                    <span>Quantity:</span>

                    <select id="qty">
                        @for (int i = 1; i <= 100; i++)
                        {
                            <option value="@i">@i</option>
                        }
                    </select>
                </div>

                <p class="details-price">@Model.Product.Price.ToString("c")</p>
            </div>

            <div class="text-center">
                <form id="addToCartForm"
                      asp-controller="ShoppingCart"
                      asp-action="AddOrUpdateItem">

                    <input type="hidden" name="productId" value="@Model.Product.Id" />

                    <input type="hidden" name="quantity" id="hiddenQty" value="1" />

                    <button class="button add-to-cart" type="submit">
                        Add To Cart
                    </button>
                </form>
            </div>

            <a class="go-to-cart button"
                   asp-controller="shoppingcart"
                   asp-action="index">
                Go To Cart <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>
</section>

<hr />

<section class="product-listof-category">
    <div class="container-fluid ">
        <div class="category-products grid grid-col-4">

            @foreach (var product in Model.ProductsList.OrderBy(p => Guid.NewGuid()))
            {
                <div class="show-card button">

                    <a style="text-decoration:none"
                           asp-controller="product"
                           asp-action="ProductDetails"
                           asp-route-productId="@product.Id">

                        <img class="show-image"
                             src="@product.ImageUrl"
                             loading="lazy"
                             alt="@product.Description"
                             onerror="this.onerror=null;this.src='/img/placeholder.jpg';" />

                        <div class="show-card-body align-content-center ">
                            <p class="show-card-description">@product.Description</p>
                            <p class="product-name text-center">@product.Name</p>
                        </div>
                    </a>

                    <div class="flex-price">
                        <button class="add-to-cart-btn  btn-link p-0"
                                data-product-id="@product.Id">
                            <i class="bi bi-cart-plus fs-4"></i>
                        </button>
                        <p class="product-price">@product.Price.ToString("c")</p>
                    </div>
                </div>
            }

        </div>
    </div>
</section>

@section Scripts {
    <script>
        $(function () {

            // ================================
            // ✅ INITIAL QUANTITY
            // ================================

            $("#hiddenQty").val($("#qty").val());

            // ================================
            // ✅ UPDATE SELECTED QUANTITY
            // ================================

            $("#qty").on("change", function () {

                $("#hiddenQty").val($(this).val());
            });

            // ================================
            // ✅ MAIN PRODUCT ADD TO CART
            // ================================

            $("#addToCartForm").on("submit", function (e) {

                e.preventDefault();

                var form = $(this);

                var button = $(".add-to-cart");

                // ✅ prevent spam click
                button.prop("disabled", true);

                $.ajax({
                    url: form.attr("action"),
                    type: "POST",
                    data: form.serialize(),

                    success: function (res) {

                        if (res.success) {

                            // ✅ update cart badge
                            updateCartBadge(res.count);

                            // ✅ button feedback
                            button
                                .text("Added ✔")
                                .addClass("added");

                            toastr.success("Added to cart successfully");

                            setTimeout(() => {

                                button
                                    .text("Add To Cart")
                                    .removeClass("added")
                                    .prop("disabled", false);

                            }, 1500);
                        }
                    },

                    error: function (xhr) {

                        let message = "Error adding to cart";

                        // ✅ backend message
                        if (xhr.responseJSON &&
                            xhr.responseJSON.message) {

                            message = xhr.responseJSON.message;
                        }

                        toastr.error(message);

                        // ✅ enable button again
                        button.prop("disabled", false);
                    }
                });

            });

            // ================================
            // ✅ PRODUCT CARD ADD TO CART
            // ================================

            $(".add-to-cart-btn").on("click", function () {

                var button = $(this);

                var icon = button.find("i");

                var productId = button.data("product-id");

                // ✅ prevent spam click
                button.prop("disabled", true);

                $.ajax({
                    url: '/ShoppingCart/AddOrUpdateItem',
                    type: 'POST',

                    data: {
                        productId: productId,
                        quantity: 1
                    },

                    success: function (res) {

                        // ✅ icon animation
                        icon.removeClass("bi-cart-plus")
                            .addClass("bi-check text-success");

                        // ✅ update cart badge
                        updateCartBadge(res.count);

                        toastr.success("Added to cart successfully");

                        setTimeout(function () {

                            icon.removeClass("bi-check text-success")
                                .addClass("bi-cart-plus");

                            button.prop("disabled", false);

                        }, 1500);
                    },

                    error: function (xhr) {

                        let message = "Error adding to cart";

                        // ✅ backend message
                        if (xhr.responseJSON &&
                            xhr.responseJSON.message) {

                            message = xhr.responseJSON.message;
                        }

                        toastr.error(message);

                        // ✅ enable again
                        button.prop("disabled", false);
                    }
                });

            });

        });

        // ================================
        // ✅ CART BADGE HANDLER
        // ================================

        function updateCartBadge(count) {

            if (count <= 0) {

                $("#cart-count").hide();

            } else {

                $("#cart-count")
                    .show()
                    .text(count);
            }
        }

    </script>
}