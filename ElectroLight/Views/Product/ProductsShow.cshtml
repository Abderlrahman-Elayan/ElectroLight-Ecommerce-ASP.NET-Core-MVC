@model ProductShowVM
<div class="text-url-history-span text-url-history">
    <a class="text-url-history" asp-controller="Home" asp-action="Index">Home</a>
    @if (Model.CategoryName != null)
    {
        <i class="bi bi-chevron-right"></i> 
        @Model.CategoryName
    }
</div>
<div class="scroll-x category-tag-container container">
    @foreach (var category in Model.CategoriesList)
    {
        <a class="category-tag button" asp-action="ProductsShow" asp-route-categoryId="@category.Id">@category.Name</a>
        <a class="category-tag button" asp-action="ProductsShow" asp-route-categoryId="@category.Id">@category.Name</a>
    }
</div>
<div class="container justify-content-center">
    <div class="grid-col-6">
        @foreach (var product in Model.ProductsList)
        {
            <div class="show-card button">
              
                <img class="show-image" src="@product.ImageUrl" loading="lazy" alt="@product.Description" onerror="this.onerror=null;this.src='/img/placeholder.jpg';" />
                <div class="show-card-body align-content-center ">
                    <p class="show-card-description">@product.Description</p>
                    <p class="product-name text-center">@product.Name</p>
                    <div class="flex-price">
                        <a href="#" class="cart"><i class="bi bi-cart-plus"></i></a>
                        <p class="product-price">@product.Price.ToString("c")</p>

                    </div>
                </div>
            </div>
        }
    </div>
</div>

