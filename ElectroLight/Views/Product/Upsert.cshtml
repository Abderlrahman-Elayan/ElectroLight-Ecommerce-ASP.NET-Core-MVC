@{
    ViewData["PageType"] = "admin-page";
}
@model ProductVM
<div class="container custom-view mt-3">
<div class="card shadow-lg">
    @if (Model.Product.Id == 0)
    {
            <div class="card-header bg-warning bg-gradient text-center text-light"><h1 class="text-dark fw-bold title-card-header">Create Product</h1></div>
    }
    else
    {
            <div class="card-header bg-success bg-gradient text-center"><h1 class="text-dark fw-bold title-card-header">Edit Product</h1></div>
    }
    <div class="card-body">
        <div class="row">
            <div style="width:180px;height:180px" class="col-2 mx-auto shadow border  border-opacity-75 rounded-3 p-0 overflow-hidden ratio-1x1">
                <img src="@Model.Product.ImageUrl"
                     alt="@Model.Product.Description"
                     onerror="this.onerror=null;this.src='/img/placeholder.jpg';"
                     class="w-100 h-100 object-fit-cover">
            </div>
        </div>
        <div class="row">
            <form asp-action="Upsert" enctype="multipart/form-data">
                <input hidden asp-for="Product.Id" />
                <div class="row">
                    <div asp-validation-summary="All" class="text-danger"></div>
                    <div class="form-floating   col-6 py-1 mb-3">
                        <input asp-for="Product.Name" class="form-control" />
                        <label asp-for="Product.Name" class="control-label ms-2"></label>
                        <span asp-validation-for="Product.Name" class="text-danger"></span>
                    </div>
                    <div class="form-floating   col-6  py-1 mb-3">
                        <input asp-for="Product.Description" class="form-control" />
                        <label asp-for="Product.Description" class="control-label ms-2"></label>
                        <span asp-validation-for="Product.Description" class="text-danger"></span>
                    </div>
                    <div class="form-floating   col-6  py-1 mb-3">
                        <input asp-for="Product.Price" class="form-control" type="number" step="0.01" />
                        <label asp-for="Product.Price" class="control-label ms-2"></label>
                        <span asp-validation-for="Product.Price" class="text-danger"></span>
                    </div>
                    <div class="form-floating   col-6  py-1 mb-3">
                        <input asp-for="Product.StockQuantity" class="form-control" />
                        <label asp-for="Product.StockQuantity" class="control-label ms-2"></label>
                        <span asp-validation-for="Product.StockQuantity" class="text-danger"></span>
                    </div>
                    <div class="form-floating  col-6  py-1 mb-3">
                        <input asp-for="Product.ImageUrl" class="form-control" hidden />
                        <input asp-for="Product.Image" class="form-control" accept="image/*" />
                        <label asp-for="Product.Image" class="control-label ms-2"></label>
                        <span asp-validation-for="Product.ImageUrl" class="text-danger"></span>
                    </div>
                    <div class="form-floating  col-6  pb-1 mb-3">
                        <select asp-for="Product.CategoryId" asp-items="@Model.CategoriesList" class="form-select border shadow">
                            <option disabled selected>-- Select Category --</option>
                        </select>
                        <label asp-for="Product.CategoryId" class="control-label ms-2"></label>
                        <span asp-validation-for="Product.CategoryId" class="text-danger"></span>
                    </div>
                </div>
                <div class="form-group mt-3">
                    @if (Model.Product.Id == 0)
                    {
                        <input type="submit" value="Create" class="btn btn-warning text-dark fw-bold " />
                    }
                    else
                    {
                        <input type="submit" value="Edit" class="btn btn-success text-dark fw-bold " />

                    }
                </div>
            </form>
        </div>
    </div>
</div>


<div>
    <a asp-action="Index">Back to List</a>
</div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        const imageInput = document.getElementById("Product_Image"); 
        const imagePreview = document.querySelector(".col-2 img"); 

        imageInput.addEventListener('change', function () {
            const file = this.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    imagePreview.src = e.target.result; 
                };
                reader.readAsDataURL(file);
            } else {
                imagePreview.src = "@Model.Product.ImageUrl";
            }
        });
    </script>
}
