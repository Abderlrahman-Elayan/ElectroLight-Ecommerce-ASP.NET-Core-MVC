@model ProductVM

<div class="card shadow-lg">
    @if (Model.Product.Id == 0)
    {
        <div class="card-header bg-warning bg-gradient text-center text-light"><h2 class="text-dark fw-bold">Create Product</h2></div>
    }
    else
    {
        <div class="card-header bg-success bg-gradient text-center"><h2 class="text-dark fw-bold">Edit Product</h2></div>
    }
    <div class="card-body">
        <div class="row">
            <div class="col-2 mx-auto shadow border border-warning border-opacity-75 rounded-3 p-0 overflow-hidden ratio-1x1">
                <img src="@Model.Product.ImageUrl"
                     alt="@Model.Product.Description"
                     class="w-100 h-100 object-fit-cover">
            </div>
        </div>
        <div class="row">
            <form asp-action="Upsert">
                <input hidden asp-for="Product.Id" />
                <div class="row">
                    <div asp-validation-summary="All" class="text-danger"></div>
                    <div class="form-floating   col-6 py-1 mb-3">
                        <input asp-for="Product.Name" class="form-control" />
                        <label asp-for="Product.Name" class="control-label ms-2"></label>
                        <span asp-validation-for="Product.Name" class="text-danger"></span>
                    </div>
                    <div class="form-floating   col-6  py-1 mb-3">
                        <input asp-for="Product.Description" class="form-control" />
                        <label asp-for="Product.Description" class="control-label ms-2"></label>
                        <span asp-validation-for="Product.Description" class="text-danger"></span>
                    </div>
                     <div class="form-floating   col-6  py-1 mb-3">
                        <input asp-for="Product.Price" class="form-control" type="number" step="0.01" />
                        <label asp-for="Product.Price" class="control-label ms-2"></label>
                        <span asp-validation-for="Product.Price" class="text-danger"></span>
                    </div>
                    <div class="form-floating   col-6  py-1 mb-3">
                        <input asp-for="Product.StockQuantity" class="form-control" />
                        <label asp-for="Product.StockQuantity" class="control-label ms-2"></label>
                        <span asp-validation-for="Product.StockQuantity" class="text-danger"></span>
                    </div>
                    <div class="form-floating  col-6  py-1 mb-3">
                        <input asp-for="Product.ImageUrl" class="form-control" />
                        <label asp-for="Product.ImageUrl" class="control-label ms-2"></label>
                        <span asp-validation-for="Product.ImageUrl" class="text-danger"></span>
                    </div>
                    <div class="form-floating  col-6  py-1 mb-3">
                        <select asp-for="Product.CategoryId" asp-items="@Model.CategoriesList" class="form-select border shadow">
                            <option disabled selected>-- Select Category --</option>
                        </select>
                        <label asp-for="Product.CategoryId" class="control-label ms-2"></label>
                        <span asp-validation-for="Product.CategoryId" class="text-danger"></span>
                    </div>
                </div>
                <div class="form-group mt-3">
                    @if (Model.Product.Id == 0)
                    {
                        <input type="submit" value="Create" class="btn btn-warning text-dark fw-bold " />
                    }
                    else
                    {
                        <input type="submit" value="Edit" class="btn btn-success text-dark fw-bold " />

                    }
                </div>
            </form>
        </div>
    </div>
</div>


<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
